{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "splitwiser-26",
          "appId": "1:612502468471:android:13ca6930914bd0361f1372",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "splitwiser-26",
          "configurations": {
            "android": "1:612502468471:android:13ca6930914bd0361f1372",
            "ios": "1:612502468471:ios:c3cf93eab89349c91f1372",
            "macos": "1:612502468471:ios:f1c4c08378d25c831f1372",
            "web": "1:612502468471:web:bbf98a0b7441cf051f1372",
            "windows": "1:612502468471:web:9c248138240df0371f1372"
          }
        }
      }
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Pragma", "value": "no-cache" },
          { "key": "Expires", "value": "0" }
        ]
      },
      {
        "source": "split-wise-app",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"split-wise.apk\"" }
        ]
      },
      {
        "source": "**/*.apk",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Content-Disposition", "value": "attachment" }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/app.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/app",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/app/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/split-wise-app",
        "destination": "https://github.com/Pavilion108/split-wise-app/releases/latest/download/spliti5-v1.0.19-release.apk",
        "type": 302
      },
      {
        "source": "/split-wise.apk",
        "destination": "https://github.com/Pavilion108/split-wise-app/releases/latest/download/spliti5-v1.0.19-release.apk",
        "type": 302
      },
      {
        "source": "/spliti5-ios.ipa",
        "destination": "https://github.com/Pavilion108/split-wise-app/releases/latest/download/spliti5-ios-release.ipa",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/portal",
        "destination": "/portal.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
